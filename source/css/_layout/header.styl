#header-left {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  align-items: center;

  &-menu-list {
    display: flex;
    margin-left: 1rem;
    box-sizing: border-box;
    align-items: center;

    &.hidden {
      display: none;
    }

    &.desktop-hidden {
      display: none;
    }

    #header-left-menu-close {
      display: none;
    }

    .header-left-menu-list-item {
      margin: 0.5rem 0.5rem;
      font-size: 1rem;
      font-weight: bolder;
      hover-underline(0);
    }
  }
}

#header-center {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
}

#header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;

  &-search {
    &.hidden {
      display: none;
    }

    .fas {
      display block
      width 1em
      height 1em
      font-size: .9rem;
      line-height 1
      margin: 0;
    }
  }

  &-appearance {
    &-symbol {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: .9rem;
      line-height: 1;
      transition: transform .62s cubic-bezier(.32, .72, .18, 1), filter .22s ease;
    }

    &:hover .header-right-appearance-symbol,
    &:focus-visible .header-right-appearance-symbol {
      filter: saturate(1.25) drop-shadow(0 0 .35rem $color-theme);
    }

    &[aria-pressed='true'] .header-right-appearance-symbol {
      transform: rotate(180deg);
    }
  }

  &-title {
    hover-underline(50%);

    &.hidden {
      display: none;
    }

      .header-right-title-text {
      font-weight: bolder;
    }
  }

  &-time {
    &.hidden {
      display: none;
    }

    .header-right-time-time {
      font-weight: bolder;
    }
  }
}

.chrome-control {
  control-surface()
}

.chrome-control-icon {
  display: grid;
  width: var(--dt-control-size);
  height: var(--dt-control-size);
  padding: 0;
  place-items: center;
}

.chrome-control-round {
  border-radius: 50%;
}

.header-inline {
  display: grid;
  min-width: 0;
  min-height: var(--dt-control-size);
  place-items: center;
  white-space: nowrap;
}

#header-left-menu-icon {
  margin-left: var(--dt-header-edge-gap);
  font-size: 1rem;
}

#header-right-search,
#header-right-appearance {
  margin-right: var(--dt-header-control-gap);
}

@media (pointer: coarse) {
  :root {
    --dt-control-size: 44px;
    --dt-header-edge-gap: .25rem;
    --dt-header-control-gap: .25rem;
  }

  #header-left-menu-icon {
    margin-right: 0.25rem;
    margin-left: 0.25rem;
  }
}

@media (max-width: 1279px) {
  #header-left-menu-list {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: .5rem;
    margin: 0;
    padding: unquote('max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left))');
    overflow-y: auto;
    background: var(--dt-overlay);
    backdrop-filter: blur(18px);

    &.show {
      display: flex;
    }

    #header-left-menu-close {
      margin: 0 0 1rem auto;
    }

    .chrome-mobile-control {
      control-surface()
    }

    .header-left-menu-list-item {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: .75rem 1rem;
      font-size: clamp(1.15rem, 5vw, 1.5rem);
      border-radius: .75rem;
    }
  }
}

@media (max-width: 767px) {
  #header-wrapper {
    position: relative;
  }

  #header-right-time {
    display: none;
  }

  #header-right-title {
    position: absolute;
    left: 50%;
    max-width: calc(100vw - 10rem);
    overflow: hidden;
    text-overflow: ellipsis;
    transform: translateX(-50%);
  }
}
