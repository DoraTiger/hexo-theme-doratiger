#header-left {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  align-items: center;

  &-menu-icon {
    button-hover-effect()
    display: flex;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 1rem;
    font-size: 1rem;
    align-items: center;
    justify-content: center;
    background-color: $color-button-background;
    border-radius: 4px;
  }

  &-menu-list {
    display: flex;
    margin-left: 1rem;
    box-sizing: border-box;
    align-items: center;

    &.hidden {
      display: none;
    }

    .header-left-menu-list-item {
      margin: 0.5rem 0.5rem;
      font-size: 1rem;
      font-weight: bolder;
      hover-underline(0);
    }
  }
}

#header-center {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
}

#header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;

  &-search {
    control-surface()
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    margin-right: .75rem;
    padding: 0;
    place-items: center;
    border-radius: .5rem;

    &.hidden {
      display: none;
    }

    .fas {
      display block
      width 1em
      height 1em
      font-size: .9rem;
      line-height 1
      margin: 0;
    }
  }

  &-appearance {
    control-surface()
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    margin-right: .75rem;
    padding: 0;
    place-items: center;
    border-radius: 50%;

    &-symbol {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: .9rem;
      line-height: 1;
      transition: transform .62s cubic-bezier(.32, .72, .18, 1), filter .22s ease;
    }

    &:hover .header-right-appearance-symbol,
    &:focus-visible .header-right-appearance-symbol {
      filter: saturate(1.25) drop-shadow(0 0 .35rem $color-theme);
    }

    &[aria-pressed='true'] .header-right-appearance-symbol {
      transform: rotate(180deg);
    }
  }

  &-title {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }

      .header-right-title-text {
      font-weight: bolder;
    }
  }

  &-time {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    margin-right: 1rem;

    &.hidden {
      display: none;
    }

    .header-right-time-time {
      font-weight: bolder;
    }
  }
}

@media (pointer: coarse) {
  #header-left-menu-icon,
  #header-right-search,
  #header-right-appearance {
    width: 44px;
    height: 44px;
    margin-right: 0.25rem;
    margin-left: 0.25rem;
  }
}
