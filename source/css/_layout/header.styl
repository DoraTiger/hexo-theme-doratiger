#header-left {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  align-items: center;

  &-menu-list {
    display: flex;
    margin-left: 1rem;
    box-sizing: border-box;
    align-items: center;

    &.hidden {
      display: none;
    }

    &.desktop-hidden {
      display: none;
    }

    #header-left-menu-close {
      display: none;
    }

    .header-left-menu-list-item {
      margin: 0.5rem 0.5rem;
      font-size: 1rem;
      font-weight: bolder;
      hover-underline(0);
    }
  }
}

#header-center {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
}

#header-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;

  &-search {
    &.hidden {
      display: none;
    }

    .fas {
      display block
      width 1em
      height 1em
      font-size: .9rem;
      line-height 1
      margin: 0;
    }
  }

  &-appearance {
    border-radius: 50%;

    &-symbol {
      font-family: ui-sans-serif, system-ui, sans-serif;
      font-size: .9rem;
      line-height: 1;
      transition: transform .62s cubic-bezier(.32, .72, .18, 1), filter .22s ease;
    }

    &:hover .header-right-appearance-symbol,
    &:focus-visible .header-right-appearance-symbol {
      filter: saturate(1.25) drop-shadow(0 0 .35rem $color-theme);
    }

    &[aria-pressed='true'] .header-right-appearance-symbol {
      transform: rotate(180deg);
    }
  }

  &-title {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }

      .header-right-title-text {
      font-weight: bolder;
    }
  }

  &-time {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    margin-right: 1rem;

    &.hidden {
      display: none;
    }

    .header-right-time-time {
      font-weight: bolder;
    }
  }
}

#header-left-menu-icon,
#header-right-search,
#header-right-appearance {
  control-surface()
  display: grid;
  width: 2.2rem;
  height: 2.2rem;
  padding: 0;
  place-items: center;
}

#header-left-menu-icon {
  margin-left: 1rem;
  font-size: 1rem;
}

#header-right-search,
#header-right-appearance {
  margin-right: .75rem;
}

@media (pointer: coarse) {
  #header-left-menu-icon,
  #header-right-search,
  #header-right-appearance {
    width: 44px;
    height: 44px;
    margin-right: 0.25rem;
    margin-left: 0.25rem;
  }
}

@media (max-width: 1279px) {
  #header-left-menu-list {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: .5rem;
    margin: 0;
    padding: unquote('max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(1.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left))');
    overflow-y: auto;
    background: var(--dt-overlay);
    backdrop-filter: blur(18px);

    &.show {
      display: flex;
    }

    #header-left-menu-close {
      control-surface()
      display: grid;
      width: 44px;
      height: 44px;
      margin: 0 0 1rem auto;
      place-items: center;
      border-radius: 50%;
    }

    .header-left-menu-list-item {
      control-surface()
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: .75rem 1rem;
      font-size: clamp(1.15rem, 5vw, 1.5rem);
      border-radius: .75rem;
    }
  }
}
