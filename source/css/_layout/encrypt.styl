// 文章加密样式
.hexo-encrypt
  padding clamp(1rem, 4vw, 2rem)
  border-radius 8px
  border 1px solid $color-border
  background $color-content-background

  .hexo-encrypt-abstract
    font-size 0.95rem
    color $color-text
    opacity 0.7
    margin-bottom 1.5rem
    text-align center

  .hexo-encrypt-input
    display flex
    flex-wrap wrap
    gap 0.5rem
    max-width 400px
    margin 0 auto

    .hexo-encrypt-password
      form-field()
      flex 1 1 10rem
      padding 0.6rem 1rem
      font-size 0.9rem

    .hexo-encrypt-submit
      action-control()
      padding 0.6rem 1rem
      font-size 1rem

  .hexo-encrypt-data
    display none

  .hexo-encrypt-error
    max-width 400px
    margin 0.75rem auto 0
    color $color-theme
    font-size 0.9rem
    text-align left
