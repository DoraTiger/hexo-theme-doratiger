#post, #post-recent {
  width: 100%;
  display: flex;
  flex-direction: column;

  .post-item {
    display: flex;
    flex-direction: column;
    align-content: center;
    margin: 2rem 0;
    background: $color-content-background;
    border-radius: 4px;

    &-header {
      display: flex;
      flex-direction: column;

      &-title {
        margin: 1rem 2rem 1rem 2rem;
        font-size: 1.5rem;
        line-height: 2rem;
        text-align: left;
      }

      &-meta {
        margin: 0rem 2rem 1rem 2rem;
        font-size: 1rem;
        text-align: left;
        color: $color-text;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.25rem 0;

        &-item {
          button-hover-effect();
          display: inline-block;
          padding: 0.25rem 0.25rem 0.25rem 0.25rem;
          align-content: center;
          text-align: center;
          margin-right: 0.5rem;

          &-icon {
            margin-left: 0.25rem;
            margin-right: 0.5rem;
          }

          &-text {
            margin-right: 0.5rem;

            &:hover {
              color: $color-theme;
            }
          }
        }
      }

      // 文章置顶标记
      &-sticky {
        display: inline-block;
        margin-right: 0.5rem;
        padding: 0.1rem 0.5rem;
        font-size: 0.75rem;
        color: $color-theme;
        border: 1px solid $color-theme;
        border-radius: 4px;
        opacity: 0.8;
      }
    }

    &-content {
      margin: 0rem 2rem 1rem 2rem;
      line-height: 1.5rem;

      blockquote {
        color: gray;
        border-left: $color-sub-theme solid 2px;
        margin: 1rem 0 1rem 1rem;
        padding-left: 1rem
      }

      img {
        max-width: 100%;
        height: auto;
        margin: 1rem 0 1rem 0;
      }

      a {
        color: $color-sub-theme;

        &:hover {
          color: $color-theme;
        }
      }

      table {
        margin: 8px 0 16px 0;
        max-width: 100%;

        thead {
          tr {
            th {
              padding: 0.5rem 1rem;
              border: 1px solid $color-border;
              background: $color-content-background;
              white-space: nowrap;
            }
          }
        }

        tbody {
          tr {
            td {
              padding: 0.5rem 1rem;
              border: 1px solid $color-border;
            }
          }
        }
      }

      h1, h2, h3, h4, h5, h6 {
        position: relative;
        cursor: pointer;
        transition: $transition-delay;
        padding-left: 1.5rem;
        color: $color-text;

        &::before {
          position: absolute;
          top: 50%;
          left: 0;
          transform: translateY(-50%);
          color: $color-sub-theme;
          content: '\f0c1';
          font: normal normal normal 12px / 1 FontAwesome;
          font-size: 0.8rem;
          transition: $transition-delay;
        }

        &:hover {
          padding-left: 2rem;

          &::before {
            color: $color-theme;
          }
        }
      }

      ol, ul {
        margin-top: 0.5rem;
        padding: 0 0 0 1rem;
        list-style: none;
        counter-reset: li;

        p {
          margin: 0;
        }

        ol, ul {
          padding-left: 0.5rem;
        }

        li {
          position: relative;
          margin: 0.25rem 0;
          padding: 0.125px 0.8px 0.125rem 2.5rem;

          &:hover {
            &:before {
              transform: rotate(360deg);
              color: $color-theme;
            }
          }

          &:before {
            position: absolute;
            top: 0;
            left: 0;
            background: $color-content-background;
            color: $color-sub-theme;
            cursor: pointer;
            transition: $transition-delay;
          }
        }
      }

      ol {
        li {
          &:before {
            margin-top: 0.2rem;
            width: w = 1.5rem;
            height: h = w;
            border-radius: 0.5 * w;
            content: counter(li);
            counter-increment: li;
            text-align: center;
            font-size: 0.8rem;
            font-weight: 600;
            line-height: h;
          }
        }
      }

      ul {
        li {
          &:hover {
            &:before {
              border-color: $color-theme;
            }
          }

          &:before {
            $w = 0.4rem;
            top: 0.6rem;
            margin-left: 0.25rem;
            width: w = $w;
            height: h = w;
            border: 0.3 * w solid $color-content-background;
            // border-radius w
            background: transparent;
            content: '';
            line-height: h;
            transform: rotateZ(45deg);
          }
        }
      }

      code {
        padding: 0.2rem 0.2rem;
        background: $color-code-background;
        border-radius: 4px;
        color: $color-text;
      }
    }

    &-copyright {
      display: block;
      margin: 0rem 2rem 1rem 2rem;
      padding: 1rem;
      background: $color-content-background;
      border-radius: 4px;

      &-info {
        flex: 1;
        min-width: 0;
      }

      &-item {
        display: block;
        padding: 0.25rem 0;
        align-content: center;

        &-meta {
          margin-left: 0.25rem;
          margin-right: 0.5rem;
          color: $color-theme;
        }

        &-text {
          margin-right: 0.5rem;

          a {
            color: $color-sub-theme;

            &:hover {
              color: $color-theme;
            }
          }
        }
      }

      &-qrcode {
        float: right;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 0 .75rem 1rem;
        padding: 0.75rem;
        background: white;
        border-radius: 8px;
        border: 1px solid $color-border;

        .post-item-qrcode-img {
          img {
            width: 80px;
            height: 80px;
            border-radius: 4px;
          }
        }

        &-tip {
          margin-top: 0.5rem;
          font-size: 0.75rem;
          line-height: 1rem;
          color: $color-text-muted;
          text-align: center;
          white-space: nowrap;
        }
      }

      &::after {
        display: block;
        clear: both;
        content: '';
      }
    }

    &-ai-link {
      color: $color-text;
      text-decoration: none;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    &-ai {
      overflow-wrap: anywhere;
      scroll-margin-top: 1rem;

      &-note {
        font-size: .875em;
        color: $color-text-muted;
      }
    }

    &-comment {
      margin: 0rem 2rem 1rem 2rem;
      background: $color-content-background;
      border-radius: 4px;
    }

    &-sponsor {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 0;
      margin-top: 1rem;
      border-top: 1px solid $color-border;

      &-btn {
        action-control();
        padding: 0.5rem 1.5rem;
        border-radius: 20px;
        font-size: 0.9rem;
      }

      &-panel {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 1rem;

        &[hidden] { display: none; }

        &-tip {
          font-size: 0.85rem;
          color: $color-text;
          opacity: 0.6;
          margin-bottom: 1rem;
        }

        &-codes {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          max-width: 100%;
          gap: 1.5rem;

          &-code {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;

            img {
              width: 160px;
              max-width: 100%;
              height: 160px;
              border-radius: 8px;
              padding: 0.5rem;
              background: white;
            }

            span {
              font-size: 0.8rem;
              color: $color-text;
              opacity: 0.6;
            }
          }
        }
      }
    }
  }
}

// 注记：所有样式已整合到 #post 块内使用原生嵌套方式

#post, #post-recent
  .post-item
    margin 1.5rem 0
    overflow hidden
    background $color-content-background
    border 1px solid $color-border
    border-radius 16px
    box-shadow 0 16px 42px rgba(0, 0, 0, .12)
    transition background .68s ease, border-color .68s ease, box-shadow .68s ease, color .68s ease

    &-header-title
      font-family "Noto Serif CJK SC", "Source Han Serif SC", STSong, serif
      font-size clamp(1.35rem, 2vw, 1.8rem)
      line-height 1.45

    &-content
      line-height 1.8
      color $color-text

      table, pre
        display block
        max-width 100%
        overflow-x auto

      img
        border-radius 10px
        box-shadow 0 10px 30px rgba(0, 0, 0, .16)

    &-more
      control-surface()
      display inline-flex
      align-items center
      justify-content center
      color $color-text-muted
      font-size .8rem
      min-width 5rem
      width auto
      min-height 44px
      margin 0 2rem 1.5rem
      padding .55rem .9rem
      border-radius 10px

      &::after
        content '\f105'
        display inline-block
        margin-left .45rem
        color $color-theme
        font-family "Font Awesome 6 Free"
        font-size .8em
        font-weight 900
        opacity 0
        transform translateX(-.3rem)
        transition opacity $transition-duration ease, transform $transition-duration ease

      &:hover::after, &:focus-visible::after
          opacity 1
          transform translateX(0)

@media (max-width: 767px)
  #post, #post-recent
    .post-item
      &-header-title, &-header-meta, &-content, &-copyright, &-comment
        margin-left 1rem
        margin-right 1rem
      &-more
        margin-left 1rem
        margin-right 1rem

      &-copyright-qrcode
        display none

@media (min-width: 1600px)
  #post .post-item
    padding 1rem 0

    &-header-title, &-header-meta, &-content, &-copyright, &-comment, &-sponsor
      width calc(100% - 4rem)
      margin-left auto
      margin-right auto
