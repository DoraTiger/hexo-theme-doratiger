#sidebar-menu {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  height: 4rem;

  .sidebar-menu-item {
    button-hover-effect();
    width: 6rem;
    height: 2rem;
    line-height: 2rem;
    font-size: 1rem;
    text-align: center;

    span {
      display: block;
      width: 100%;
    }
  }
}

#sidebar-toc {
  display: flex;
  flex-direction: column;
  justify-content: left;
  height: auto;
  width: 90%;

  &.hide {
    display: none;
    opacity: 0;
  }

  .sidebar-toc-title {
    margin-top: 2rem;
    font-size: 1.2rem;
    text-align: center;
    color: $color-text;
  }

  .sidebar-toc-progress {
    margin-top: 2rem;
    font-size: 1rem;

    &-notice {
      text-align: center;
    }

    &-num {
      font-weight: 600;
    }

    &-percentage {
    }

    &-bar {
      margin-top: 0.5rem;
      height: 0.125rem;
      width: 0;
      background: $color-theme;
    }
  }

  .sidebar-toc-content {
    position: relative;
    margin-top: 2rem;
    padding-left: 1rem;
    font-size: 1rem;
    height: auto;
    color: $color-text;

    &::before {
      position: absolute;
      top: 0.35rem;
      bottom: 0.35rem;
      left: 0.3rem;
      width: 1px;
      content: '';
      background: linear-gradient(to bottom, transparent, $color-border 8%, $color-border 92%, transparent);
      opacity: 0.85;
    }

    .top {
      display: none;
    }

    .toc-item, .toc {
      line-height: 1.5rem;

      .toc-item {
        margin: 0.45rem 0;
      }

      .toc-link {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        padding: 0.2rem 0.15rem 0.2rem 0.85rem;
        color: $color-text-muted;
        letter-spacing: 0.01em;
        transition: color $transition-duration ease, transform $transition-duration ease;

        &::before {
          position: absolute;
          top: 50%;
          left: -0.93rem;
          z-index: 1;
          width: 0.52rem;
          height: 0.52rem;
          content: '';
          border: 1px solid $color-border;
          border-radius: 50%;
          background: var(--dt-chrome);
          box-shadow: 0 0 0 0 transparent;
          transform: translateY(-50%) scale(0.72);
          transition: background $transition-duration ease, border-color $transition-duration ease, box-shadow $transition-duration ease, transform $transition-duration ease;
        }

        &:hover {
          color: $color-theme;
          transform: translateX(0.18rem);

          &::before {
            border-color: $color-theme;
            background: $color-theme;
            box-shadow: 0 0 0.5rem var(--dt-accent-glow);
            transform: translateY(-50%) scale(0.94);
          }
        }

        &.active {
          color: $color-theme;
          font-weight: 600;

          &::before {
            border-color: $color-theme;
            background: $color-theme;
            box-shadow: 0 0 0.58rem var(--dt-accent-glow);
            transform: translateY(-50%) scale(1);
          }
        }
      }
    }

    ol, li {
      padding: 0;
      margin: 0;
      list-style: none; /* 禁用所有列表的标记 */
    }

    .toc-child {
      padding-left: 1.1rem;
      height: 0;
      overflow: hidden;
      transition: $transition-delay ease;

      &.expanded {
        height: auto;
        transition: $transition-delay ease;
      }
    }
  }
}

#sidebar-info {
  &.hide {
    display: none;
    opacity: 0;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    align-items: center;

    &-avatar {
      margin-top: 1rem;
      border-radius: 50%;
      overflow: hidden;

      &-img {
        padding: 0.125rem;
        width: 7.5rem;
        height: 7.5rem;
        border-radius: 50%;
        border: 0.125rem solid $color-button-background;

        &:hover {
          animation: avatar 5s linear infinite;
        }
      }
    }

    &-name {
      margin-top: 1rem;
      color: $color-text;
    }

    &-description {
      margin-top: 1.5rem;
    }

    &-social-link {
      margin-top: 1.5rem;
      padding: 0 1rem;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;

      &-item {
        button-hover-effect();
        margin-top: 1rem;
        margin-right: 1rem;
        padding: 0.5rem 0.5rem 0.5rem 0.5rem;
        border-radius: 4px;
        background: $color-button-background;

        &-dot {
          margin-left: 0.25rem;
          display: inline-block;
          width: 0.5rem;
          height: 0.5rem;
          border-radius: 50%;
        }
      }
    }

    &-articles {
      display: flex;
      flex-direction: row;
      margin-top: 1.5rem;

      &-item {
        border-animation();
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0.5em 1rem 0.5rem 1rem;

        &-text {
          margin-top: 0.5rem;
        }

        &-num {
          font-weight: 600;
        }

        &::after {
          content: '';
          position: absolute;
          right: 0;
          top: 1.5rem;
          width: 0.05rem;
          height: 2rem;
          background: $color-border;
        }

        &:last-child::after {
          display: none;
        }
      }
    }
  }

  .friend-link {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;

    &-item {
      button-hover-effect();
      display: block;
      padding: 0.5rem 0.5rem 0.5rem 0.5rem;
      text-align: center;
      margin-top: 1rem;
      width: 80%;
    }
  }
}
