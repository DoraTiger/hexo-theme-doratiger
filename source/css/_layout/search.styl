#search-container {
  position fixed
  z-index 100
  inset 0
  display: none;
  align-items center
  justify-content center
  padding unquote('max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left))')

  .search-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    width: min(42rem, 100%);
    max-height: 100%;
    overflow-y: auto;
    themed-scrollbar()
    background: var(--dt-surface-raised);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .32);
    border: 1px solid $color-control-border;
    border-radius: 18px;
    transform: translateY(.9rem) scale(.985)
    opacity: 0
    transition: transform .24s ease, opacity .24s ease, background .35s ease

    &-header {
      display: flex;
      justify-content: space-between;
      line-height: 2rem;

      &-title {
      }

      &-logo {
        height: 2rem;
        width: auto;
      }

      &-closebutton {
        display: grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        color: $color-text-muted;
        border: 1px solid $color-control-border;
        border-radius: 50%;
        cursor: pointer;

        &:hover, &:focus-visible {
          color: $color-theme;
          border-color: $color-theme;
          background: $color-control;
        }
      }
    }

    &-box {
      margin-top: 1rem;
      border: 2px solid $color-theme;
      border-radius: 4px;
      background: var(--dt-surface);
      height: 2.5rem;
      display: flex;
      align-items: center;

      &-input {
        width: 100%;
        height: 100%;
        padding: 0 0.75rem;
        font-size: 1rem;
        border: none;
        background: transparent;
        box-sizing: border-box;
        line-height: 2.5rem;

        &:focus {
          outline: none;
        }
      }
    }

    &-result {
      margin-top: 1rem;


    }

    &-pagination {
      justify-content: center;

    }
  }

  .search-mask {
    position: absolute;
    inset: 0;
    background: var(--dt-overlay);
    backdrop-filter: blur(14px) saturate(.78);
    -webkit-backdrop-filter: blur(14px) saturate(.78);
  }

  &.show {
    display: flex;

    .search-content {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
}

// 本地搜索标签
.search-content-header-logo
  font-size 0.9rem
  color var(--dt-text-muted)
  padding 0.2rem 0.6rem
  border 1px solid var(--dt-border)
  border-radius 4px

// 本地搜索结果高亮
#algolia-hits mark
  background rgba(230, 119, 0, 0.3)
  color inherit
  padding 0 2px
  border-radius 2px
