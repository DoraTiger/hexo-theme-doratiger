#footer-left {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
  align-items: center;

  &-sidebar-icon {
    button-hover-effect()
    display: flex;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 1rem;
    font-size: 1rem;
    align-items: center;
    justify-content: center;
    background-color: $color-button-background;
    border-radius: 4px;
    transition: $transition-delay;

    &.closed {
      transition: $transition-delay;
      transform: rotate(180deg);
    }

  }
}

#footer-center {
  display: flex;
  flex-shrink: 0;
  box-sizing: border-box;
}

#footer-right {
  display: flex;
  flex-wrap: wrap;
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-end;
  container-name: footer-records;
  container-type: inline-size;

  .footer-right-separator {
    margin: 0.25rem 0.25rem;
  }

  &-statistics {
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }
  }

  &-copyright {
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }

    .copyright {
    }
  }

  &-miit {
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }

    .miit-text {
    }
  }

  &-mps {
    margin-right: 1rem;
    hover-underline(50%);

    &.hidden {
      display: none;
    }

    a.mps-text {
      display: inline-flex;
      align-items: center;
    }
  }

  .footer-right-record-icon {
    flex: 0 0 1rem;
    width: 1rem;
    height: 1rem;
    margin-right: 0.125rem;
    object-fit: contain;
  }
}

@container footer-records (max-width: 74rem) {
  #footer-right .footer-right-community-records-item:nth-of-type(2) {
    display: none;
  }
}

@container footer-records (max-width: 63rem) {
  #footer-right .footer-right-community-records-item:nth-of-type(1) {
    display: none;
  }
}

@media (pointer: coarse) {
  #footer-left-sidebar-icon {
    width: 44px;
    height: 44px;
    margin-left: 0;
  }
}
