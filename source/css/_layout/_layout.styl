*, *::before, *::after
  box-sizing border-box

html
  height 100%
  scroll-behavior smooth
  background var(--dt-canvas)

body
  display flex
  height 100%
  margin 0
  color $color-text
  font-family "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif
  font-size $font-size
  line-height 1.75
  background transparent

pre, code, kbd, samp, .post-item-header-meta
  font-family "JetBrainsMono Nerd Font", "CaskaydiaCove Nerd Font", ui-monospace, SFMono-Regular, Consolas, monospace

a
  color inherit
  text-decoration none

.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

button
  font inherit
  color inherit
  border 0
  background transparent

a:focus-visible, button:focus-visible, input:focus-visible
  outline 3px solid $color-sub-theme
  outline-offset 3px

#celestial-sky, #universe
  position fixed
  inset 0
  width 100%
  height 100%

#celestial-sky
  z-index -2
  overflow hidden
  background var(--dt-canvas)
  transition background 1.1s ease

  &::before, &::after
    position absolute
    inset -10%
    content ''
    pointer-events none
    z-index 0
    transition opacity 1.1s ease, filter 1.1s ease

  &::before
    opacity 1
    background radial-gradient(100% 100% at 70% 120%, #212750 10%, #020409 100%)

  &::after
    opacity 0
    background linear-gradient(145deg, #dce9ee 0%, #fdf6e3 52%, #eee8d5 100%)
    filter saturate(.88)

#celestial-orbit
  position absolute
  top 95%
  left 90%
  width 154vh
  height 154vh
  transform translate(-50%, -50%) rotate(0deg)
  transform-origin center
  transition transform 1.1s cubic-bezier(.55, 0, .25, 1)
  will-change transform
  z-index 2

.celestial-body
  position absolute
  left 50%
  display grid
  width clamp(3.25rem, 5vw, 6.75rem)
  height clamp(3.25rem, 5vw, 6.75rem)
  place-items center
  border-radius 50%
  font-family ui-sans-serif, system-ui, sans-serif
  font-size clamp(2rem, 3.2vw, 4rem)
  line-height 1

.celestial-body-moon
  top 0
  transform translate(-50%, -50%)
  filter drop-shadow(0 0 .85rem rgba(216, 226, 255, .4))

.celestial-body-sun
  bottom 0
  transform translate(-50%, 50%)
  filter drop-shadow(0 0 1.35rem rgba(255, 196, 85, .7))

#celestial-atmosphere
  position absolute
  inset 0
  overflow hidden
  pointer-events none
  opacity 0
  transition opacity .7s ease
  z-index 1

  &::before, &::after
    position absolute
    content ''
    pointer-events none

  &::before
    inset -15% -20%
    opacity .78
    background radial-gradient(ellipse at 22% 30%, rgba(219, 230, 231, .48) 0 5%, transparent 17%), radial-gradient(ellipse at 58% 20%, rgba(235, 241, 239, .56) 0 4%, transparent 16%), radial-gradient(ellipse at 78% 56%, rgba(213, 226, 228, .42) 0 6%, transparent 20%)
    animation cloud-drift 28s linear infinite alternate

  &::after
    top 4%
    right 8%
    width 32rem
    height 32rem
    border-radius 50%
    background radial-gradient(circle, rgba(181, 137, 0, .17) 0, rgba(181, 137, 0, .07) 26%, transparent 64%)
    filter blur(1.5rem)
    animation sun-haze 8s ease-in-out infinite alternate

#universe
  z-index -1
  background $color-background
  background transparent

html[data-appearance='day'] #celestial-sky
  &::before
    opacity 0

  &::after
    opacity 1
    filter saturate(1)

  #celestial-atmosphere
    opacity 1

  #celestial-orbit
    transform translate(-50%, -50%) rotate(180deg)

@media (prefers-color-scheme: light)
  html[data-appearance='system'] #celestial-sky
    &::before
      opacity 0

    &::after
      opacity 1
      filter saturate(1)

    #celestial-atmosphere
      opacity 1

    #celestial-orbit
      transform translate(-50%, -50%) rotate(180deg)

#sidebar-container
  position fixed
  inset 0 auto 0 0
  z-index 20
  width $sidebar-width
  overflow-y auto
  padding 1.25rem 0 1.25rem env(safe-area-inset-left)
  background var(--dt-chrome)
  border-right 1px solid $color-border
  transition transform .22s ease, background .68s ease, border-color .68s ease, color .68s ease

#main-container
  display flex
  flex 1
  flex-direction column
  height 100dvh
  min-width 0
  margin-left $sidebar-width
  overflow hidden
  transition margin-left .22s ease

#header-wrapper
  z-index 10
  display flex
  align-items center
  justify-content space-between
  min-height $main-header-height
  flex-shrink 0
  padding 0 unquote('max(.75rem, env(safe-area-inset-right))') 0 unquote('max(.75rem, env(safe-area-inset-left))')
  background var(--dt-chrome)
  border-bottom 1px solid $color-border
  backdrop-filter blur(10px)
  transition background .68s ease, border-color .68s ease, color .68s ease

#content-wrapper
  display block
  flex 1
  min-height 0
  width 100%
  overflow-x hidden
  overflow-y auto

#content-wrapper, #sidebar-container
  themed-scrollbar()

  #content
    width calc(100% - 2rem)
    max-width $main-content-max-width
    margin 0 auto

@media (min-width: 1280px)
  :root
    --dt-celestial-safe-space: clamp(10rem, 14vw, 18rem)

  #content-wrapper #content
    width unquote('min(var(--dt-stage-width), calc(100% - (var(--dt-celestial-safe-space) * 2) - 2rem))')
    max-width none

@media (min-width: 1600px)
  :root
    --dt-stage-width: unquote('min(78rem, calc(100vw - 24rem))')

  #content-wrapper #content
    padding 0 2.5rem

@media (min-width: 2560px)
  :root
    // Keep the 4K stage generous without turning a long article into a wall of text.
    --dt-stage-width: unquote('min(104rem, calc(100vw - 32rem))')
    --dt-celestial-safe-space: 10rem

#footer-wrapper
  display flex
  min-height $main-footer-height
  flex-shrink 0
  align-items center
  justify-content space-between
  gap .75rem
  padding .75rem unquote('max(1rem, env(safe-area-inset-right))') unquote('max(.75rem, env(safe-area-inset-bottom))') unquote('max(1rem, env(safe-area-inset-left))')
  margin-left 0
  border-top 1px solid $color-border
  background var(--dt-chrome)
  transition background .68s ease, border-color .68s ease, color .68s ease

#return-top
  position fixed
  right unquote('max(1rem, env(safe-area-inset-right))')
  bottom unquote('calc(var(--dt-footer-height, 3rem) + 1rem + max(1rem, env(safe-area-inset-bottom)))')
  z-index 15
  display grid
  width 44px
  height 44px
  place-items center
  opacity 0
  color $color-text
  background $color-button-background
  border 1px solid $color-border
  border-radius 12px
  cursor pointer
  transition opacity .18s ease, transform .18s ease

  &.show
    opacity 1

#sidebar-container.closed
  transform translateX(-100%)

#sidebar-container.closed ~ #main-container
  margin-left 0

@media (max-width: 1279px)
  :root
    --dt-celestial-safe-space: 0

  #sidebar-container
    transform translateX(-100%)

    &.open
      transform translateX(0)

  #main-container
    margin-left 0

  // On narrow screens the sidebar is an overlay. Its only toggle lived in
  // the covered footer, so do not expose a control that cannot be used to
  // return from the overlay.
  #footer-wrapper #footer-left
    display none

@media (max-width: 767px)
  #celestial-orbit
    top 108%
    left 92%
  #header-wrapper
    min-height 3.5rem
  #content-wrapper #content
    width calc(100% - 1.25rem)
  #footer-wrapper
    flex-wrap wrap
    align-content center
    font-size .82rem

  // Footer space is reserved for statutory registrations first.  Community
  // records and ancillary metadata are hidden by the responsive controller;
  // the two legal records may naturally flow onto separate rows.
  #footer-right
    flex 1 1 100%
    width 100%
    row-gap .35rem
    column-gap .75rem

    &-statistics, &-copyright, .footer-right-community-records-item
      display none

    &-miit, &-mps
      margin-right 0

@media (max-height: 700px) and (min-width: 768px)
  #header-wrapper
    min-height 2.75rem
  #sidebar-container
    padding .5rem 0

@media (pointer: coarse)
  button, a, #return-top
    min-width 44px
    min-height 44px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    scroll-behavior auto !important
    transition-duration .01ms !important
    animation-duration .01ms !important
    animation-iteration-count 1 !important
