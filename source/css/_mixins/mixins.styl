// 鼠标悬停时，下划线从指定位置扩展到两侧，同时改变文字颜色
// @param $left 下划线的初始位置距离左侧百分比（默认值为0）
hover-underline($left = 0) {
  position: relative;
  transition: $transition-delay;

  &:after {
    content: '';
    position: absolute;
    left: $left;
    bottom: 0;
    width: 0;
    height: 0.125rem;
    background: $color-theme;
    transition: $transition-delay;
  }

  &:hover {
    color: $color-theme;
    transition: $transition-delay;

    a {
      color: $color-theme;
    }

    &:after {
      left: 0;
      width: 100%;
      transition: $transition-delay;
    }
  }
}

// 鼠标悬停时，边框从指定位置扩展到四周，同时改变文字颜色
border-animation() {
  position: relative;
  .line {
    position: absolute;
    transition: $transition-delay;
    background: $color-theme;

    &-top {
      width: 0;
      height: 1px;
      left: -110%;
      top: -1px;
    }

    &-right {
      width: 1px;
      height: 0;
      right: -1px;
      top: -110%;
    }

    &-bottom {
      width: 1px;
      height: 0;
      left: -1px;
      bottom: -110%;
    }

    &-left {
      width: 0;
      height: 1px;
      bottom: -1px;
      right: -110%;
    }
  }

  &:hover {
    color: $color-theme;
    transition: $transition-delay;

    .line-top {
      width: 100%;
      left: 0;
    }

    .line-right {
      height: 100%;
      top: 0;
    }

    .line-bottom {
      height: 100%;
      bottom: 0;
    }

    .line-left {
      width: 100%;
      right: 0;
    }

    a {
      color: $color-theme;
    }
  }
}

// 定义按钮动效
control-surface() {
  position: relative; // 设置按钮为相对定位，以便其伪元素（::before）可以相对于按钮定位。
  overflow: hidden; // 隐藏超出按钮范围的内容，确保光影效果不会溢出按钮。
  background: $color-control;
  border: 1px solid $color-control-border;
  border-radius: .5rem;
  cursor: pointer;
  transition: background $transition-duration ease, border-color $transition-duration ease, color $transition-duration ease, box-shadow $transition-duration ease;

  &::before {
    content: ''; // 伪元素必须设置 content，即使为空。
    position: absolute; // 将伪元素设置为绝对定位，相对于按钮（position: relative）定位。
    left: 0;
    top: 0;
    width: 100%; // 设置伪元素宽度为按钮宽度，使其光影效果完全覆盖按钮。
    height: 100%; // 设置伪元素高度为按钮高度，使其光影效果完全覆盖按钮。
    pointer-events: none;
    background: linear-gradient(110deg, transparent 0%, rgba(255, 255, 255, .2) 42%, transparent 62%);
    transform: translateX(-135%);
    // Reset outside the control without replaying the sweep on pointer exit.
    opacity: 0;
    transition: none;
  }

  // 鼠标悬停效果
  &:hover:not(:disabled), &:focus-visible {
    color: $color-theme;
    background: $color-control-hover;
    border-color: $color-theme;
    box-shadow: 0 .35rem .9rem rgba(0, 43, 54, .18);
    &::before {
      opacity: 1;
      transform: translateX(135%);
      transition: transform $transition-duration ease;
    }
  }
}

pagination-list() {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

pagination-control() {
  control-surface();
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
  min-height: 2.5rem;
  padding: .35rem .5rem;
  line-height: 1.25;
  text-decoration: none;
  color: $color-text;
  box-sizing: border-box;
}

// Shared filled actions and form fields; components only supply layout.
action-control() {
  control-surface()
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  color: $color-on-accent;
  background: $color-theme;
  border-color: $color-theme;
  min-height: 44px;

  &:hover:not(:disabled), &:focus-visible {
    color: $color-on-accent;
    background: $color-theme;
  }

  &:disabled {
    opacity: .55;
    cursor: not-allowed;
  }
}

form-field() {
  min-width: 0;
  color: $color-text;
  background: $color-control;
  border: 1px solid $color-control-border;
  border-radius: .5rem;
  font: inherit;
  transition: border-color $transition-duration ease, background $transition-duration ease;

  &::placeholder {
    color: $color-text-muted;
    opacity: 1;
  }

  &:focus-visible {
    outline: 2px solid $color-sub-theme;
    outline-offset: 2px;
  }
}

themed-scrollbar() {
  scrollbar-width: thin;
  scrollbar-color: var(--dt-scroll-thumb) var(--dt-scroll-track);

  &::-webkit-scrollbar {
    width: .65rem;
  }

  &::-webkit-scrollbar-track {
    background: var(--dt-scroll-track);
  }

  &::-webkit-scrollbar-thumb {
    background: var(--dt-scroll-thumb);
    border: 2px solid var(--dt-scroll-track);
    border-radius: 1rem;
  }

  &::-webkit-scrollbar-thumb:hover {
    background: $color-theme;
  }
}

button-hover-effect() {
  control-surface()
}
