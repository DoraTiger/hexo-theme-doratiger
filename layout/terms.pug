extends _include/_layout.pug

block content
  article#post
    .post-item
      .post-item-content
        h1= theme.terms.title || _p('terms.title')

        p: strong= __('terms.last_updated', new Date().toISOString().split('T')[0])

        p= _p('terms.intro')

        h2= _p('terms.service.title')
        p= _p('terms.service.description')

        h2= _p('terms.conduct.title')
        p= _p('terms.conduct.description')

        h2= _p('terms.intellectual_property.title')
        - const license = theme.terms.license || (theme.copyright && theme.copyright.license) || "CC BY-NC-SA 4.0"
        - const link = (theme.copyright && theme.copyright.link) || "https://creativecommons.org/licenses/by-nc-sa/4.0/"
        p
          span= _p('terms.intellectual_property.before_license') + ' '
          a(href=link target="_blank")= license
          | #{_p('terms.intellectual_property.after_license')}

        h2= _p('terms.disclaimer.title')
        p= _p('terms.disclaimer.description')

        h2= _p('terms.privacy.title')
        p
          | #{_p('terms.privacy.before_link')}
          a(href=url_for('/privacy/'))= _p('privacy.title')
          | #{_p('terms.privacy.after_link')}

        if theme.terms.extra_content
          != theme.terms.extra_content

        h2= _p('terms.contact.title')
        if theme.copyright && theme.copyright.email
          p
            span= _p('terms.contact.with_email') + ' '
            a(href="mailto:" + theme.copyright.email)= theme.copyright.email
        else
          p= _p('terms.contact.without_email')
