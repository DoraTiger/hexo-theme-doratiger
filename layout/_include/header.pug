mixin header-search
  - const searchMenu = _p('header.search.menu')
  if (theme.search.enable)
    button#header-right-search(type='button' aria-label=searchMenu aria-controls='search-container' aria-expanded='false')
      i.fas.fa-search(aria-hidden='true')
      span.sr-only= searchMenu

mixin header-time
  if (theme.header.time.enable)
    #header-right-time
      span.header-right-time-time

mixin header-appearance
  - const switchToDay = _p('header.appearance.switch_to_day')
  - const switchToNight = _p('header.appearance.switch_to_night')
  button#header-right-appearance(type='button' aria-label=switchToDay aria-pressed='false' data-day-label=switchToDay data-night-label=switchToNight)
    span.header-right-appearance-symbol(aria-hidden='true') 🌙

#header-left
  button#header-left-menu-icon(type='button' aria-label=_p('header.navigation.toggle') aria-controls='header-left-menu-list' aria-expanded='true')
    i.fas.fa-bars
  #header-left-menu-list
    each item in (theme.header.menu || [])
      - let i18n = item.key + ".menu"
      a.header-left-menu-list-item(href=url_for(item.url))= _p(i18n)

#header-center

#header-right
  +header-search
  +header-appearance
  #header-right-title
    a.header-right-title-text(href=config.root)= config.title
  +header-time
