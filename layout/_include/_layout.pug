doctype html
html(lang=config.language data-appearance=(theme.style && theme.style.appearance) || 'night' data-redirect-path=url_for('/redirect/') data-page-visible-title=_p('page_visibility.visible') data-page-hidden-title=_p('page_visibility.hidden'))
  head
    include head.pug
  body
    //- 全局背景元素
    #celestial-sky(aria-hidden="true")
      #celestial-orbit
        span.celestial-body.celestial-body-moon 🌙
        span.celestial-body.celestial-body-sun ☀️
      #celestial-atmosphere
    canvas(id="universe")

    //- 侧边栏容器
    #sidebar-container
      include sidebar.pug

    //- 主体容器
    #main-container
      //- 头部
      header#header-wrapper
        include header.pug

      //- 内容
      main#content-wrapper
        #content
          block content
        #return-top
          i.fas.fa-arrow-up(aria-hidden="true")

      //- 底部
      footer#footer-wrapper
        include footer.pug

    include search.pug
