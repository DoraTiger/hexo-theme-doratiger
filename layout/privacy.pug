extends _include/_layout.pug

block content
  article#post
    .post-item
      .post-item-content
        h1= theme.privacy.title || _p('privacy.title')

        p: strong= __('privacy.last_updated', new Date().toISOString().split('T')[0])

        p= _p('privacy.intro')

        h2= _p('privacy.collection.title')
        p= _p('privacy.collection.description')
        ul
          li= _p('privacy.collection.access_log')
          li= _p('privacy.collection.cookie')
          li= _p('privacy.collection.contact')

        h2= _p('privacy.use.title')
        p= _p('privacy.use.description')
        ul
          li= _p('privacy.use.service')
          li= _p('privacy.use.analytics')
          li= _p('privacy.use.response')

        h2= _p('privacy.protection.title')
        p= _p('privacy.protection.description')

        h2= _p('privacy.third_party.title')
        p= _p('privacy.third_party.description')

        h2= _p('privacy.updates.title')
        p= _p('privacy.updates.description')

        if theme.privacy.extra_content
          != theme.privacy.extra_content
